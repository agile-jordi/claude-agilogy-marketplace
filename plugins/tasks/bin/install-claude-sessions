#!/bin/bash
# install-claude-sessions [<dir>]: puts claude-sessions in <dir> (default ~/.local/bin) as a script that runs
# bin/claude-sessions of the version of this plugin that Claude Code has installed, so plugin updates reach it.
# Run it from the installed plugin (~/.claude/plugins/cache/<marketplace>/<plugin>/<version>), not from a
# checkout of its repository: the plugin and marketplace names come from that path.
set -eu
dir=${1:-$HOME/.local/bin}
version_dir=$(cd "$(dirname "$0")/.." && pwd -P)
plugin=$(basename "$(dirname "$version_dir")")
marketplace=$(basename "$(dirname "$(dirname "$version_dir")")")
mkdir -p "$dir"
cat > "$dir/claude-sessions" <<EOF
#!/bin/bash
installed=\$(jq -r '.plugins["$plugin@$marketplace"] // [] | map(.installPath) | first // empty' \\
  "\$HOME/.claude/plugins/installed_plugins.json" 2>/dev/null)
[ -f "\$installed/bin/claude-sessions" ] || { echo "claude-sessions: the $plugin plugin is not installed" >&2; exit 1; }
exec zsh "\$installed/bin/claude-sessions" "\$@"
EOF
chmod 755 "$dir/claude-sessions"
echo "Installed $dir/claude-sessions"
case ":$PATH:" in *":$dir:"*) ;; *) echo "$dir is not on your PATH: add it" ;; esac
